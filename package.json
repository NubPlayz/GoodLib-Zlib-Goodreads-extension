{
  "name": "goodlib",
  "displayName": "GoodLIB -Zlib & Anna's Archive Extension",
  "version": "1.0.10",
  "description": "Open books from Goodreads,StoryGraph,Hardcover,Babelio and more in Z-Lib,Anna's Archive,AudiobookBay or GutenBerg in one click.",
  "author": "Plasmo Corp. <foss@plasmo.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "plasmo package"
  },
  "dependencies": {
    "animejs": "^4.3.6",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
